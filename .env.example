# Copy to .env and fill in. .env is gitignored.

# OpenRouter key, used for the AI chat that drafts documents.
# Routed to openrouter/openai/gpt-oss-120b with Cerebras as the inference provider.
OPENROUTER_API_KEY=

# Host port for the app. Defaults to 8000; set this if something else on the
# machine already holds it. Only the host side moves - the container still
# listens on 8000 internally.
PRELEGAL_PORT=

# Marks the session cookie Secure. Leave false for local use: nothing in
# scripts/ terminates TLS, and a Secure cookie on an http origin is dropped by
# the browser without saying so - which looks like signing in and being signed
# straight back out. Set it to true only behind real HTTPS.
PRELEGAL_SESSION_COOKIE_SECURE=false
